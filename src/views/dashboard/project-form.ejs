<%- include('_head') %>
<%
const val = (name) => (project[name] === null || project[name] === undefined) ? '' : project[name];
%>
<div class="page-head">
    <h1><%= isNew ? 'Add Project' : 'Edit Project' %></h1>
    <a class="btn btn-ghost" href="/projects">Back to Projects</a>
</div>
<% if (Object.keys(errors).length) { %><p class="error" role="alert">Please fix the highlighted fields.</p><% } %>
<form method="POST" action="<%= action %>" enctype="multipart/form-data" class="card form-grid" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field wide">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= val('title') %>" maxlength="255" required>
        <% if (errors.title) { %><small class="error"><%= errors.title %></small><% } %>
    </div>

    <div class="field wide">
        <label for="slug">Slug <span class="muted">(URL name; leave blank to generate from the title)</span></label>
        <input type="text" id="slug" name="slug" value="<%= val('slug') %>" maxlength="255">
        <% if (errors.slug) { %><small class="error"><%= errors.slug %></small><% } %>
    </div>

    <div class="field wide">
        <label for="shortDescription">Short Description</label>
        <input type="text" id="shortDescription" name="shortDescription" value="<%= val('shortDescription') %>" maxlength="255">
        <% if (errors.shortDescription) { %><small class="error"><%= errors.shortDescription %></small><% } %>
    </div>

    <div class="field wide">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="7" maxlength="10000"><%= val('description') %></textarea>
        <% if (errors.description) { %><small class="error"><%= errors.description %></small><% } %>
    </div>

    <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category">
            <% categories.forEach(option => { %><option value="<%= option %>" <%= val('category') === option ? 'selected' : '' %>><%= option %></option><% }) %>
        </select>
        <% if (errors.category) { %><small class="error"><%= errors.category %></small><% } %>
    </div>

    <div class="field">
        <label for="type">Type</label>
        <select id="type" name="type">
            <% types.forEach(option => { %><option value="<%= option %>" <%= val('type') === option ? 'selected' : '' %>><%= option %></option><% }) %>
        </select>
        <% if (errors.type) { %><small class="error"><%= errors.type %></small><% } %>
    </div>

    <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
            <% statuses.forEach(option => { %><option value="<%= option %>" <%= val('status') === option ? 'selected' : '' %>><%= option %></option><% }) %>
        </select>
        <% if (errors.status) { %><small class="error"><%= errors.status %></small><% } %>
    </div>

    <div class="field">
        <label for="role">Role</label>
        <input type="text" id="role" name="role" value="<%= val('role') %>" maxlength="255">
        <% if (errors.role) { %><small class="error"><%= errors.role %></small><% } %>
    </div>

    <div class="field">
        <label for="startDate">Start Date</label>
        <input type="date" id="startDate" name="startDate" value="<%= val('startDate') %>">
        <% if (errors.startDate) { %><small class="error"><%= errors.startDate %></small><% } %>
    </div>

    <div class="field">
        <label for="endDate">End Date</label>
        <input type="date" id="endDate" name="endDate" value="<%= val('endDate') %>">
        <% if (errors.endDate) { %><small class="error"><%= errors.endDate %></small><% } %>
    </div>

    <div class="field">
        <label for="displayOrder">Display Order</label>
        <input type="number" id="displayOrder" name="displayOrder" value="<%= val('displayOrder') %>" min="0" max="9999">
        <% if (errors.displayOrder) { %><small class="error"><%= errors.displayOrder %></small><% } %>
    </div>

    <div class="field check">
        <label><input type="checkbox" name="isFeatured" <%= project.isFeatured ? 'checked' : '' %>> Featured</label>
    </div>

    <div class="field wide">
        <label for="github">GitHub Link</label>
        <input type="url" id="github" name="github" value="<%= val('github') %>" maxlength="255" placeholder="https://github.com/...">
        <% if (errors.github) { %><small class="error"><%= errors.github %></small><% } %>
    </div>

    <div class="field wide">
        <label for="demo">Demo / Download Link</label>
        <input type="url" id="demo" name="demo" value="<%= val('demo') %>" maxlength="255">
        <% if (errors.demo) { %><small class="error"><%= errors.demo %></small><% } %>
    </div>

    <div class="field wide">
        <label for="website">Website Link</label>
        <input type="url" id="website" name="website" value="<%= val('website') %>" maxlength="255">
        <% if (errors.website) { %><small class="error"><%= errors.website %></small><% } %>
    </div>

    <div class="field wide">
        <label for="imageFile">Upload Main Image <span class="muted">(replaces the main image and thumbnail below; JPEG, PNG, WebP or GIF, 6 MB max)</span></label>
        <% if (val('thumbnail') || val('image')) { %><img class="preview" src="<%= val('thumbnail') || val('image') %>" alt="Current main image"><% } %>
        <input type="file" id="imageFile" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif">
        <% if (errors.imageFile) { %><small class="error"><%= errors.imageFile %></small><% } %>
    </div>

    <div class="field wide">
        <label for="image">Main Image Path</label>
        <input type="text" id="image" name="image" value="<%= val('image') %>" maxlength="255" placeholder="/images/projects/my-project/01-home.webp">
        <% if (errors.image) { %><small class="error"><%= errors.image %></small><% } %>
    </div>

    <div class="field wide">
        <label for="thumbnail">Thumbnail Path</label>
        <input type="text" id="thumbnail" name="thumbnail" value="<%= val('thumbnail') %>" maxlength="255" placeholder="/images/projects/my-project/01-home-thumb.webp">
        <% if (errors.thumbnail) { %><small class="error"><%= errors.thumbnail %></small><% } %>
    </div>

    <div class="field wide">
        <label for="technologies">Technologies <span class="muted">(one per line, or comma separated)</span></label>
        <textarea id="technologies" name="technologies" rows="4"><%= project.technologiesText %></textarea>
        <% if (errors.technologies) { %><small class="error"><%= errors.technologies %></small><% } %>
    </div>

    <div class="field wide">
        <label for="media">Screenshots <span class="muted">(one per line: Title | image path | thumbnail path)</span></label>
        <textarea id="media" name="media" rows="8" class="mono"><%= project.mediaText %></textarea>
        <% if (errors.media) { %><small class="error"><%= errors.media %></small><% } %>
    </div>

    <div class="field wide">
        <label for="screenshotFiles">Upload Screenshots <span class="muted">(added to the list above; up to 8 at a time, titled from the file name, which you can edit after saving)</span></label>
        <input type="file" id="screenshotFiles" name="screenshotFiles" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
        <% if (errors.screenshotFiles) { %><small class="error"><%= errors.screenshotFiles %></small><% } %>
    </div>

    <div class="wide form-actions">
        <button type="submit" class="btn btn-primary"><%= isNew ? 'Create Project' : 'Save Changes' %></button>
        <a class="btn btn-ghost" href="/projects">Cancel</a>
    </div>
</form>
<%- include('_foot') %>
