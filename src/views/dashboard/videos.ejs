<%- include('_head') %>
<div class="page-head"><h1>Music Videos</h1></div>

<form method="POST" action="/videos" class="card video-add" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Add a Video</h2>
    <div class="video-row">
        <div class="field">
            <label for="new-title">Title</label>
            <input type="text" id="new-title" name="title" value="<%= newVideo.title %>" maxlength="255" required>
            <% if (editingId === null && errors.title) { %><small class="error"><%= errors.title %></small><% } %>
        </div>
        <div class="field">
            <label for="new-url">YouTube Link or Video ID</label>
            <input type="text" id="new-url" name="url" value="<%= newVideo.url %>" maxlength="300" required placeholder="https://youtu.be/...">
            <% if (editingId === null && errors.url) { %><small class="error"><%= errors.url %></small><% } %>
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<div class="card">
    <h2>All Videos (<%= videos.length %>)</h2>
    <% videos.forEach(video => {
        const editing = editingId === video.id && typeof editValues !== 'undefined';
        const title = editing ? editValues.title : video.title;
        const url = editing ? editValues.url : video.videoId;
    %>
        <div class="video-item">
            <form method="POST" action="/videos/<%= video.id %>" class="video-row" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="field">
                    <label for="title-<%= video.id %>">Title</label>
                    <input type="text" id="title-<%= video.id %>" name="title" value="<%= title %>" maxlength="255" required>
                    <% if (editing && errors.title) { %><small class="error"><%= errors.title %></small><% } %>
                </div>
                <div class="field">
                    <label for="url-<%= video.id %>">YouTube Link or Video ID</label>
                    <input type="text" id="url-<%= video.id %>" name="url" value="<%= url %>" maxlength="300" required>
                    <% if (editing && errors.url) { %><small class="error"><%= errors.url %></small><% } %>
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-ghost" href="https://www.youtube.com/watch?v=<%= encodeURIComponent(video.videoId) %>" target="_blank" rel="noopener noreferrer">Watch</a>
                </div>
            </form>
            <form method="POST" action="/videos/<%= video.id %>/delete" class="inline delete-form"
                  data-confirm="Delete &quot;<%= video.title %>&quot; from the site?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    <% }) %>
    <% if (!videos.length) { %><p class="muted">No videos yet.</p><% } %>
</div>
<%- include('_foot') %>
