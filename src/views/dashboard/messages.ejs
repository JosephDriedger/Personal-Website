<%- include('_head') %>
<div class="page-head">
    <h1>Messages</h1>
    <span class="muted"><%= unreadMessages %> Unread</span>
</div>

<div class="card table-wrap">
    <table>
        <thead>
            <tr><th>From</th><th>Message</th><th>Received</th><th></th></tr>
        </thead>
        <tbody>
        <% items.forEach(item => { %>
            <tr class="<%= item.isRead ? '' : 'unread' %>">
                <td>
                    <a href="/messages/<%= item.id %>"><%= item.name %></a>
                    <div class="muted small"><%= item.email %></div>
                </td>
                <td class="preview-cell"><%= item.message.length > 90 ? item.message.slice(0, 90) + '…' : item.message %></td>
                <td class="nowrap"><%= formatDate(item.createdAt) %></td>
                <td class="actions">
                    <% if (!item.isRead) { %><span class="pill">New</span><% } %>
                    <a class="btn btn-ghost" href="/messages/<%= item.id %>">Open</a>
                    <form method="POST" action="/messages/<%= item.id %>/delete" class="inline"
                          data-confirm="Delete this message from <%= item.name %>? This cannot be undone.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        <% }) %>
        <% if (!items.length) { %><tr><td colspan="4" class="muted">No messages yet. Contact-form submissions will appear here.</td></tr><% } %>
        </tbody>
    </table>
</div>
<%- include('_foot') %>
